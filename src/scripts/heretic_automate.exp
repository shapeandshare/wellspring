#!/usr/bin/expect -f
# SPDX-License-Identifier: MIT
# Automates Heretic's post-optimization interactive prompts for CI/dev-cycle testing.
#
# Usage: expect src/scripts/heretic_automate.exp <save_path> <heretic_command...>
#
# This script:
# 1. Runs the provided heretic command
# 2. Waits for trial selection prompt, selects the first Pareto-optimal trial
# 3. Selects "Save the model to a local folder"
# 4. Enters the provided save path
# 5. Exits the program
#
# Prompt strings are from vendor/heretic/src/heretic/main.py (v1.4.0):
# - Line 781: "Which trial do you want to use?"
# - Line 852: "What do you want to do with the decensored model?"
# - Line 879: "Path to the folder:"

# Timeout for each expect (seconds) - abliteration can take hours
set timeout -1

# First argument is the save path, rest is the heretic command
if {[llength $argv] < 2} {
    puts stderr "Usage: expect src/scripts/heretic_automate.exp <save_path> <heretic_command...>"
    puts stderr "Example: expect src/scripts/heretic_automate.exp ./outputs/model-heretic .venv/bin/heretic --model TinyLlama/..."
    exit 1
}

set save_path [lindex $argv 0]
set heretic_cmd [lrange $argv 1 end]

puts "==> heretic_automate: save_path=$save_path"
puts "==> heretic_automate: command=$heretic_cmd"

# Spawn the heretic command
spawn {*}$heretic_cmd

# Handle checkpoint recovery prompt if it appears (previous interrupted run)
# Select "Ignore the previous run and start from scratch" (2nd option)
expect {
    "How would you like to proceed?" {
        puts "\n==> heretic_automate: Checkpoint recovery prompt detected, selecting 'start from scratch'..."
        sleep 0.5
        # Navigate to 2nd option (Ignore and start fresh)
        send "\033\[B"
        sleep 0.1
        send "\r"
        exp_continue
    }
    "Which trial do you want to use?" {
        puts "\n==> heretic_automate: Trial selection prompt detected, selecting first trial..."
        sleep 0.5
        send "\r"
    }
    timeout {
        puts stderr "==> heretic_automate: ERROR - Timed out waiting for trial selection"
        exit 1
    }
    eof {
        puts stderr "==> heretic_automate: ERROR - Process ended before trial selection"
        exit 1
    }
}

# Wait for action menu and select "Save the model to a local folder" (first option)
expect {
    "What do you want to do with the decensored model?" {
        puts "\n==> heretic_automate: Action menu detected, selecting 'Save to local folder'..."
        sleep 0.5
        send "\r"
    }
    timeout {
        puts stderr "==> heretic_automate: ERROR - Timed out waiting for action menu"
        exit 1
    }
    eof {
        puts stderr "==> heretic_automate: ERROR - Process ended before action menu"
        exit 1
    }
}

# Wait for path prompt and enter the save path
expect {
    "Path to the folder:" {
        puts "\n==> heretic_automate: Path prompt detected, entering: $save_path"
        sleep 0.5
        send "$save_path\r"
    }
    timeout {
        puts stderr "==> heretic_automate: ERROR - Timed out waiting for path prompt"
        exit 1
    }
    eof {
        puts stderr "==> heretic_automate: ERROR - Process ended before path prompt"
        exit 1
    }
}

# Wait for save completion message, then the action menu reappears
expect {
    "Model saved to" {
        puts "\n==> heretic_automate: Model saved successfully, waiting for action menu..."
    }
    timeout {
        puts stderr "==> heretic_automate: ERROR - Timed out waiting for save completion"
        exit 1
    }
    eof {
        puts stderr "==> heretic_automate: ERROR - Process ended during save"
        exit 1
    }
}

# Wait for action menu again and select exit (5th option = 4 down arrows + Enter)
expect {
    "What do you want to do with the decensored model?" {
        puts "\n==> heretic_automate: Action menu detected, selecting 'Return to trial selection'..."
        sleep 0.5
        # Navigate to 5th option (Return to trial selection / Exit program)
        send "\033\[B"
        sleep 0.1
        send "\033\[B"
        sleep 0.1
        send "\033\[B"
        sleep 0.1
        send "\033\[B"
        sleep 0.1
        send "\r"
    }
    timeout {
        puts stderr "==> heretic_automate: ERROR - Timed out waiting for post-save action menu"
        exit 1
    }
    eof {
        puts "\n==> heretic_automate: Process ended after save (expected in some cases)"
        exit 0
    }
}

# After selecting "Return to trial selection", we're back at trial menu
# Select empty/exit option to end
expect {
    "Which trial do you want to use?" {
        puts "\n==> heretic_automate: Back at trial selection, exiting..."
        sleep 0.5
        # Navigate to last option (usually "Exit" or empty choice that returns)
        # Send Ctrl+C to exit cleanly if menu navigation is tricky
        send "\003"
    }
    eof {
        puts "\n==> heretic_automate: Process completed successfully"
        exit 0
    }
    timeout {
        puts "\n==> heretic_automate: Timeout after return - assuming success"
        exit 0
    }
}

# Wait for process to end
expect eof

puts "\n==> heretic_automate: Automation complete"
exit 0
